@inherits RazorSlice<ProjectsModel>
@implements IUsesLayout<Braggarr.Web.Ui.Shared._Layout, LayoutModel>
@functions {
	public LayoutModel LayoutModel => new("Projects", Toolbar: true);

	protected override Task ExecuteSectionAsync(string name)
	{
		if (name == "Toolbar")
		{
<text>
	<a class="tool" href="#add"><svg class="icon"><use href="#i-plus" /></svg><span>Add project</span></a>
	@if (Model.Projects.Count > 0)
	{
		<form method="post" action="@Forms.Handler("/Projects", "Check")"><button class="tool"><svg class="icon"><use href="#i-sync" /></svg><span>Check releases</span></button>@Forms.Token(HttpContext!)</form>
	}
</text>
		}
		return Task.CompletedTask;
	}
}
@if (Model.Message is { } message) { <p class="banner action">@message</p> }
@if (Model.Problem is { } problem) { <p class="banner problem">@problem</p> }

@if (Model.Projects.Count == 0)
{
	<p class="empty">No projects yet. A watched project's releases become proposed campaigns, judged by Claude first if you like.</p>
}
else
{
	var briefs = await Model.BriefsAsync();
	<table class="table">
		<thead><tr><th>Project</th><th>Repository</th><th>Networks</th><th>Last release seen</th><th>Claude judges</th><th>About page group</th><th></th></tr></thead>
		<tbody>
			@foreach (var p in Model.Projects)
			{
				<tr>
					<td>
						<strong><a href="@ProjectModel.Href(p.Name)">@p.Name</a></strong>
						@if (briefs.FirstOrDefault(b => ProjectBrief.Slug(b.Project) == ProjectBrief.Slug(p.Name)) is { } brief)
						{
							<div class="small quiet">@brief.Tldr</div>
						}
						else
						{
							<div class="small"><a href="@ProjectModel.Href(p.Name)">Write its brief</a></div>
						}
					</td>
					<td><a href="https://github.com/@p.Repository">@p.Repository</a></td>
					<td class="small nets">@foreach (var name in p.Networks) { if (Networks.TryParse(name, out var pn)) { <span title="@NetworkIcons.Name(pn)" role="img" aria-label="@NetworkIcons.Name(pn)">@NetworkIcons.Icon(pn)</span> } }</td>
					<td>
						@(p.LastSeenTag ?? "not checked yet")
						@if (p.LastSkipped is { } skipped)
						{
							<div class="small quiet">Skipped @skipped.Tag: @skipped.Reason</div>
							<form method="post" class="inline" action="@Forms.Handler("/Projects", "ProposeAnyway")">
								<input type="hidden" name="repository" value="@p.Repository">
								<button name="tag" value="@skipped.Tag" class="link">Propose @skipped.Tag anyway</button>
							@Forms.Token(HttpContext!)</form>
						}
					</td>
					<td>@(p.AskClaude ? "yes" : "no")</td>
					<td>
						<form method="post" class="inline" action="@Forms.Handler("/Projects", "Assign")">
							<input type="hidden" name="repository" value="@p.Repository">
							<select name="group" aria-label="About page group of @p.Name">
								<option value="">None</option>
								@foreach (var g in Model.Groups)
								{
									<option value="@g.Title" selected="@(p.Group == g.Title)">@g.Title</option>
								}
							</select>
							<button class="link">Set</button>
						@Forms.Token(HttpContext!)</form>
					</td>
					<td><form method="post" action="@Forms.Handler("/Projects", "Unwatch")"><button name="repository" value="@p.Repository" class="link danger">Stop watching</button>@Forms.Token(HttpContext!)</form></td>
				</tr>
			}
		</tbody>
	</table>
}

<section id="about" class="panel narrow">
	<h2>About page</h2>
	<p class="small quiet">The blog's about page shows these groups in this order, each with its public projects: their line from the brief, links, latest release, stars, icon and preview. It goes to the blog as a pull request you merge.</p>
	@if (Model.Groups.Count > 0)
	{
		<ol class="groups">
			@foreach (var g in Model.Groups)
			{
				<li>
					<strong>@g.Title</strong>@if (g.Description is { } d) { <span class="small quiet"> · @d</span> }
					<form method="post" class="inline" action="@Forms.Handler("/Projects", "MoveGroup")">
						<input type="hidden" name="title" value="@g.Title">
						<button name="direction" value="up" class="link" aria-label="Move @g.Title up">Up</button>
						<button name="direction" value="down" class="link" aria-label="Move @g.Title down">Down</button>
					@Forms.Token(HttpContext!)</form>
					<form method="post" class="inline" action="@Forms.Handler("/Projects", "RemoveGroup")"><button name="title" value="@g.Title" class="link danger">Remove</button>@Forms.Token(HttpContext!)</form>
				</li>
			}
		</ol>
	}
	<form method="post" class="form" action="@Forms.Handler("/Projects", "Group")">
		<label>Group <input name="title" maxlength="@ProjectsModel.GroupTitleLimit" placeholder="For the Mac" required></label>
		<label>What it is <input name="description" placeholder="Apps for Apple silicon"></label>
		<button>Add or describe group</button>
	@Forms.Token(HttpContext!)</form>
	<form method="post" class="form" action="@Forms.Handler("/Projects", "About")">
		<label class="check"><input type="checkbox" name="redraft" value="true"> Ask Claude for a new intro (else the blog's intro stays)</label>
		<button class="primary">Propose the about page</button>
	@Forms.Token(HttpContext!)</form>
</section>

<section id="add" class="panel narrow">
	<h2>Add a project</h2>
	<form method="post" class="form" action="@Forms.Handler("/Projects", "Watch")">
		<label>Repository <input name="repository" placeholder="nullean/curb" required></label>
		<label>Name <input name="name" placeholder="Curb"></label>
		<fieldset class="networks-pick">
			<legend>Announce on</legend>
			@foreach (var n in Networks.All)
			{
				<label class="check"><input type="checkbox" name="networks" value="@n" checked="@(!n.IsManual() && n != Network.Blog)"> @NetworkIcons.Named(n)</label>
			}
		</fieldset>
		<label class="check"><input type="checkbox" name="introduce" value="true" checked> Propose an introduction campaign: its talking points, ranked, each feature worth it getting a post of its own</label>
		<label class="check"><input type="checkbox" name="askClaude" value="true" checked> Let Claude judge each release first: dependency bumps, CI changes and small fixes are skipped</label>
		<label class="check"><input type="checkbox" name="prereleases" value="true"> Prereleases too</label>
		<button class="primary">Add project</button>
	@Forms.Token(HttpContext!)</form>
</section>
